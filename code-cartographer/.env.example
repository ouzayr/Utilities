# --- Database -----------------------------------------------------------------
CC_DB_CONNECTION=Host=cc-db;Port=5432;Database=codecartographer;Username=cc;Password=cc

# --- Scanning -----------------------------------------------------------------
# Comma-separated list of absolute paths the scanners walk.
# In Docker mode, these must be paths *inside* the scanner container.
CC_REPO_ROOTS=/repos/samples

# Glob patterns to include / exclude. Defaults are sensible — only override
# if you know what you're doing.
CC_INCLUDE_GLOBS=**/*.cs,**/*.csproj,**/*.sln,**/*.ts,**/*.html,**/*.scss,**/*.css,**/angular.json,**/package.json
CC_EXCLUDE_GLOBS=**/node_modules/**,**/bin/**,**/obj/**,**/dist/**,**/.git/**,**/coverage/**

# --- Networking ---------------------------------------------------------------
CC_BIND=127.0.0.1
CC_API_PORT=8080
CC_WEB_PORT=4200

# --- Security -----------------------------------------------------------------
# Used to encrypt any PATs the user enters in the UI (GitHub / Azure DevOps).
# Leave blank to auto-generate one on first run (written to /data/secret.key).
CC_ENCRYPTION_KEY=

# --- Hard guards --------------------------------------------------------------
# When true, the API refuses to make any outbound network request.
# Do not disable.
CC_OFFLINE=true
