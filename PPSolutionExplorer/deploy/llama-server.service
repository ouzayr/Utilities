# Optional systemd unit for llama.cpp. Edit the model path once a model is chosen.
[Unit]
Description=llama.cpp server for PP Solution Explorer
After=network.target

[Service]
Type=simple
User=ppse
ExecStart=/opt/llama.cpp/llama-server -m /opt/models/MODEL.gguf -c 32768 -ngl 99 --host 127.0.0.1 --port 8080 --parallel 2
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
